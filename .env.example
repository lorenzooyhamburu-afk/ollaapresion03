# Dominio de la tienda Shopify (sin https://)
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
# Token PÚBLICO de la Storefront API (nunca el Admin token shpat_...)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Versión de la Storefront API
SHOPIFY_API_VERSION=2026-07
# Clave secreta para el endpoint /api/revalidate (inventá una larga)
SHOPIFY_REVALIDATION_SECRET=
# Monto (en pesos) a partir del cual el envío es gratis
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=30000
# URL pública del sitio (para SEO)
NEXT_PUBLIC_SITE_URL=https://animategolosineria.com.ar
